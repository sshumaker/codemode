{
  "name": "harness",
  "version": "1.0.0",
  "description": "Agent runtime where the model writes code, not tool calls — persistent kernel, MCP-to-Python compiler, durable jobs — plus the benchmark harness that measures it",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:js && npm run test:kernel && npm run test:runtime",
    "report": "node bench/residency-report.mjs",
    "iterate": "node bench/quick.mjs",
    "validate": "node bench/validate.mjs",
    "test:js": "node --test \"bench/test/*.test.mjs\"",
    "test:kernel": "node --test \"runtime/kernel/test/*.test.mjs\"",
    "test:runtime": "python3 -m unittest discover -s runtime -p 'test_*.py'",
    "eval:jobs": "node runtime/eval/all.mjs",
    "test:remote-kernel": "node --test --test-concurrency=1 --test-timeout=300000 runtime/remote-kernel/test/unit.test.mjs runtime/remote-kernel/test/link.test.mjs runtime/remote-kernel/test/fake.test.mjs",
    "test:remote-kernel:live": "node --test --test-concurrency=1 --test-timeout=900000 runtime/remote-kernel/test/live.test.mjs",
    "test:integration": "node runtime/integration/run.mjs",
    "test:live": "node runtime/integration/live/run.mjs --"
  },
  "keywords": [],
  "author": "Scott Shumaker",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@daytonaio/sdk": "^0.217.0",
    "js-tiktoken": "^1.0.21"
  },
  "private": true,
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.71"
  }
}
